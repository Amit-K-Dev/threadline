# Configure any one provider; Threadline tries them in this order:
# Gemini → Groq → OpenRouter free models.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Add these once you wire up Stripe (see README.md)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
